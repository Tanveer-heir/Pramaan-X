# Unified gateway
DETECTION_SERVICE_URL=http://ai-detection:8001
PRNU_SERVICE_URL=http://prnu-forensics:8002
DETECTION_TIMEOUT_SEC=900
PRNU_TIMEOUT_SEC=60
SOURCE_ATTRIBUTION_TIMEOUT_SEC=180
SERVICE_HEALTH_TIMEOUT_SEC=3
MAX_UPLOAD_BYTES=524288000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Detection
KIMI_API_KEY=replace-with-kimi-api-key
PRAMAAN_X_IMAGE_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1
PRAMAAN_DEVICE=cpu
DETECTION_PROCESS_TIMEOUT_SEC=900

# CPH source attribution
GEMINI_API_KEY=replace-with-gemini-api-key
APIFY_API_TOKEN=replace-with-apify-token-if-used

# PRNU
ALLOW_DEMO_MODEL=false
